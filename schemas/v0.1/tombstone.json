{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-cortex.dev/schemas/v0.1/tombstone.json",
  "title": "TombstoneRecord",
  "description": "Schema for negative-knowledge Tombstones capturing failed hypotheses and approaches.",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "schema_version",
    "created_at",
    "author_harness",
    "branch_context",
    "base_commit_sha",
    "capture_mode",
    "target_symbols",
    "attempted_approach",
    "failure_reason",
    "verification_evidence",
    "invalidation_policy"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^tmb_[0-9A-HJKMNP-TV-Z]{26}$" },
    "schema_version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "author_harness": { "type": "string" },
    "branch_context": { "type": "string" },
    "base_commit_sha": { "type": "string" },
    "capture_mode": {
      "type": "string",
      "enum": ["AUTO_REVERT_DETECTED", "MANUAL", "REWIND_SYNTHESIZED", "HOOK_ENFORCED"]
    },
    "target_symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol_uri", "ast_hash"],
        "properties": {
          "symbol_uri": { "type": "string" },
          "ast_hash": { "type": "string", "pattern": "^ast:sha256:[0-9a-f]{16}$" }
        }
      }
    },
    "attempted_approach": { "type": "string" },
    "failure_reason": { "type": "string" },
    "verification_evidence": {
      "type": "object",
      "required": ["command", "exit_code", "error_signature"],
      "properties": {
        "command": { "type": "string" },
        "exit_code": { "type": "integer" },
        "error_signature": { "type": "string" }
      }
    },
    "invalidation_policy": {
      "type": "object",
      "required": ["invalidate_on_any_ast_change"],
      "properties": {
        "invalidate_on_any_ast_change": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
